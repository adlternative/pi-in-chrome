{
  "name": "pi-in-chrome",
  "version": "1.0.0",
  "description": "Reverse-engineered from Claude Code's Chrome extension (claude-in-chrome), replicated as an unrestricted browser automation extension for Pi Coding Agent",
  "author": "ZheNing Hu <adlternative@gmail.com>",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-in-chrome",
    "claude-in-chrome",
    "browser-automation",
    "chrome",
    "mcp"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adlternative/pi-in-chrome.git"
  },
  "homepage": "https://github.com/adlternative/pi-in-chrome#readme",
  "bugs": {
    "url": "https://github.com/adlternative/pi-in-chrome/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "bin",
    "src",
    "chrome-extension",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "pi-chrome-native-host": "./bin/native-host.mjs",
    "pi-chrome-setup": "./bin/setup.mjs"
  },
  "scripts": {
    "build": "node ./scripts/build-extension.mjs",
    "build:extension": "node ./scripts/build-extension.mjs",
    "setup": "node ./bin/setup.mjs",
    "test": "node --test test/*.test.mjs",
    "test:live": "node ./test/live-test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
